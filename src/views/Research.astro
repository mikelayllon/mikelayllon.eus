---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import RefList from '../components/RefList.astro';
import { type Lang, t } from '../i18n';
import { getPage, pick } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const data = await getPage('ikerketa');
const res = pick<any>(data, lang);
const items = [...(data.argitalpenak ?? [])].sort((a: any, b: any) => String(b.urtea ?? '').localeCompare(String(a.urtea ?? '')));
---
<Base lang={lang} path="/ikerketa" title={s.ikerketa} current="ikerketa">
  <section class="wrap page-head">
    <SectionHead title={s.ikerketa} as="h1" />
    <div class="split">
      <div class="split__aside">
        <p class="big">{res.izenburua} <em>{res.izenburua_etzana}</em> {res.izenburua_amaiera}</p>
        {res.azalpena && <p class="small">{res.azalpena}</p>}
      </div>
      <div class="split__main">
        <RefList lang={lang} items={items} />
      </div>
    </div>
  </section>
</Base>
