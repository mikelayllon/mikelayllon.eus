---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { type Lang, t } from '../i18n';
import { getPage, pick, md } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const data = await getPage('zerbitzuak');
const serv = pick<any>(data, lang);
const blocks: any[] = serv.blokeak ?? [];
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} path="/zerbitzuak" title={s.zerbitzuak} description={`${serv.izenburua} ${serv.izenburua_etzana}`} current="zerbitzuak">
  <section class="wrap page-head">
    <SectionHead title={s.zerbitzuak} as="h1" />
    <div class="svc-intro">
      <p class="svc-intro__title">{serv.izenburua} <em>{serv.izenburua_etzana}</em></p>
      {serv.azalpena && <div class="svc-intro__text" set:html={md(serv.azalpena)} />}
      <nav class="svc-index" aria-label={s.zerbitzuak}>
        {blocks.map((b, i) => (
          <a href={`#${String(b.izena).toLowerCase()}`}>
            <span class="accent">{pad(i + 1)}</span> {b.izena}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <div class="wrap">
    {blocks.map((b, i) => (
      <section class="svc-block" id={String(b.izena).toLowerCase()} aria-labelledby={`b-${i}`}>
        <div class="svc-block__head">
          <p class="label accent">{pad(i + 1)} / {pad(blocks.length)}</p>
          <h2 id={`b-${i}`}>{b.izena}</h2>
        </div>
        <ol class="svc-block__list">
          {(b.zerbitzuak ?? []).map((z: any, j: number) => (
            <li>
              <span class="label muted">{pad(i + 1)}.{j + 1}</span>
              <h3>{z.izena}</h3>
              {z.azalpena && <p>{z.azalpena}</p>}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  .svc-intro { padding-top: 56px; }
  .svc-intro__title {
    margin: 0; max-width: 1100px; font-weight: 300;
    font-size: clamp(40px, 5.6vw, 84px); line-height: 1.02; letter-spacing: -0.025em; text-wrap: balance;
  }
  .svc-intro__title em { color: var(--accent); }
  .svc-intro__text {
    margin-top: 40px; max-width: 760px; font-size: 22px; line-height: 1.55; color: var(--body); text-wrap: pretty;
  }
  .svc-intro__text :global(p) { margin: 0 0 0.8em; }
  .svc-intro__text :global(p:last-child) { margin-bottom: 0; }
  .svc-intro__text :global(em) { color: var(--ink); }

  .svc-index { display: flex; flex-wrap: wrap; gap: 8px 40px; margin-top: 56px; }
  .svc-index a {
    font-family: var(--display); font-weight: 300; font-size: 28px; text-transform: uppercase;
    text-decoration: none; padding: 8px 0; letter-spacing: 0.01em;
  }
  .svc-index .accent { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.08em; vertical-align: super; }

  .svc-block {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px 64px;
    margin-top: 120px; padding-top: 24px; border-top: 1px solid var(--ink);
    scroll-margin-top: 24px;
  }
  .svc-block__head { align-self: start; position: sticky; top: 32px; }
  .svc-block__head h2 {
    margin: 16px 0 0; font-family: var(--display); font-weight: 300;
    font-size: clamp(88px, 12vw, 200px); line-height: 0.82; letter-spacing: -0.01em; text-transform: uppercase;
  }
  .svc-block__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px;
  }
  .svc-block__list li { border-top: 1px solid var(--rule); padding: 20px 0 36px; }
  .svc-block__list li:nth-child(-n + 2) { border-top-color: transparent; padding-top: 4px; }
  .svc-block__list h3 { margin: 10px 0 0; font-weight: 400; font-size: 28px; line-height: 1.12; letter-spacing: -0.01em; }
  .svc-block__list p { margin: 10px 0 0; font-size: 18px; line-height: 1.45; color: var(--body); }

  @media (max-width: 900px) {
    .svc-block { grid-template-columns: 1fr; margin-top: 80px; }
    .svc-block__head { position: static; }
  }
  @media (max-width: 600px) {
    .svc-block__list { grid-template-columns: 1fr; }
    .svc-block__list li:nth-child(2) { border-top-color: var(--rule); padding-top: 20px; }
  }
</style>
