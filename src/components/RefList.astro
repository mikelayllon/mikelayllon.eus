---
import { type Lang, t } from '../i18n';

interface Props {
  lang: Lang;
  items: any[];
  limit?: number;
}
const { lang, items, limit } = Astro.props;
const s = t(lang);
const sorted = [...items]
  .sort((a, b) => String(b.urtea ?? '').localeCompare(String(a.urtea ?? '')))
  .slice(0, limit ?? items.length);
---
<ul class="ref-list">
  {sorted.map((it) => {
    const meta = [s.refTypes[it.mota] ?? '', it.urtea].filter(Boolean).join(' · ');
    const inner = (
      <>
        <span class="ref-main">
          <span class="title">{it.izenburua}{it.esteka && <span class="ext" aria-hidden="true"> ↗</span>}</span>
          {(it.egileak || it.xehetasunak) && (
            <span class="ref-sub">
              {it.egileak}{it.egileak && it.xehetasunak && ' — '}{it.xehetasunak && <em>{it.xehetasunak}</em>}
            </span>
          )}
        </span>
        {meta && <span class="label meta">{meta}</span>}
      </>
    );
    return (
      <li>
        {it.esteka
          ? <a class="row" href={it.esteka} target="_blank" rel="noopener">{inner}</a>
          : <div class="row">{inner}</div>}
      </li>
    );
  })}
</ul>
