---
import { type Lang, url } from '../i18n';

interface Props {
  lang: Lang;
  work: any;
}
const { lang, work } = Astro.props;
const d = work.data;
const loc = { ...d.eu, ...Object.fromEntries(Object.entries(d[lang] ?? {}).filter(([, v]) => v && (!Array.isArray(v) || v.length))) };
---
<a class="work-card" href={url(lang, `/lanak/${work.id}`)}>
  {d.irudia
    ? <img class="img" src={d.irudia} alt={d.irudi_alt || ''} loading="lazy" decoding="async" />
    : <div class="ph" aria-hidden="true">{d.izenburua}</div>}
  {loc.mota && <p class="label">{loc.mota}</p>}
  <h3>{d.izenburua}</h3>
  {loc.laburpena && <p>{loc.laburpena}</p>}
</a>
